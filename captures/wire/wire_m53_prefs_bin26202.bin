nnel_id=160002&amp;is_draw=1&quot;,&quot;key&quot;:&quot;*&quot;,&quot;req_from&quot;:&quot;*&quot;},{&quot;inner_url&quot;:&quot;https://webcast-open.douyin.com/webcast/openapi/feed/?content_type=0&amp;channel_id=162003&amp;is_draw=1&quot;,&quot;key&quot;:&quot;live_channel_fm*&quot;,&quot;req_from&quot;:&quot;*&quot;},{&quot;inner_url&quot;:&quot;https://webcast-open.douyin.com/webcast/openapi/feed/?content_type=0&amp;channel_id=162006&amp;is_draw=1&quot;,&quot;key&quot;:&quot;live_channel_chat*&quot;,&quot;req_from&quot;:&quot;*&quot;},{&quot;inner_url&quot;:&quot;https://webcast-open.douyin.com/webcast/openapi/feed/?content_type=0&amp;channel_id=162004&amp;is_draw=1&quot;,&quot;key&quot;:&quot;live_channel_city*&quot;,&quot;req_from&quot;:&quot;*&quot;},{&quot;inner_url&quot;:&quot;https://webcast-open.douyin.com/webcast/openapi/feed/?content_type=0&amp;channel_id=162002&amp;is_draw=1&quot;,&quot;key&quot;:&quot;live_channel_voice*&quot;,&quot;req_from&quot;:&quot;*&quot;},{&quot;inner_url&quot;:&quot;https://webcast-open.douyin.com/webcast/openapi/feed/?content_type=0&amp;channel_id=162001&amp;is_draw=1&quot;,&quot;key&quot;:&quot;live_channel_main_tab&quot;,&quot;req_from&quot;:&quot;*&quot;},{&quot;inner_url&quot;:&quot;https://webcast-open.douyin.com/webcast/openapi/feed/?content_type=0&amp;channel_id=162001&amp;is_draw=1&quot;,&quot;key&quot;:&quot;live_channel_live*&quot;,&quot;req_from&quot;:&quot;*&quot;}],&quot;drawer_hot&quot;:&quot;https://webcast-open.douyin.com/webcast/openapi/feed/?content_type=0&amp;channel_id=161001&quot;,&quot;drawer_hot_task&quot;:&quot;https://webcast-open.douyin.com/webcast/openapi/feed/?content_type=0&amp;channel_id=165001&quot;,&quot;drawer_multi_tab_enable&quot;:false,&quot;ec_live_auction_add_btm_list&quot;:1,&quot;ec_live_enable_enter_request&quot;:0,&quot;ec_live_promotion_enhance_introduce_effect&quot;:false,&quot;ec_live_use_new_flash_dialog&quot;:true,&quot;ec_split_on_configuration_with_fragment&quot;:1,&quot;ecom_fe_coverage&quot;:&quot;{\&quot;shipping_apply_lynx\&quot;:{\&quot;enable\&quot;:true,\&quot;sample_rate\&quot;:0.001},\&quot;express_pia\&quot;:{\&quot;enable\&quot;:true,\&quot;sample_rate\&quot;:0.001}}&quot;,&quot;ecom_live_product_rank_ruler&quot;:[{&quot;content&quot;:&quot;- 抖音电商直播间带货榜是根据真实数据进行排名的直播间排行榜，希望帮助消费者通过榜单找到正在直播的好商品，让选择更简单。直播间排名越靠前曝光机会越大。&quot;,&quot;title&quot;:&quot;直播间带货榜&quot;},{&quot;content&quot;:&quot;- 直播间带货榜当前分为总榜、抖音旗舰榜、特色主题榜、国家补贴榜、商品类目榜，榜单形态持续更新中：\n- 总榜：按照上榜规则对全部电商直播间进行排序展示\n- 抖音旗舰榜：聚合抖音旗舰店铺热销直播间进行排序展示\n- 特色主题榜：由抖音电商运营就特色主题或活动，按照特定规则对直播间进行圈选后排序展示\n- 国家补贴榜：聚合正在直播国家补贴商品的直播间进行排序展示\n- 商品类目榜：按照直播间在播商品所属类目对相关直播间进行排序后展示&quot;,&quot;title&quot;:&quot;榜单介绍&quot;},{&quot;content&quot;:&quot;- 上榜直播间均为正在直播的直播间\n- 上榜作者基础要求：近30天无虚假交易处罚记录，近14天退单率无异常、无严重违规记录\n- 排序规则：以该直播间所售卖商品的【带货力、互动力、吸引力】进行综合排名，每小时结算&quot;,&quot;title&quot;:&quot;上榜规则&quot;},{&quot;content&quot;:&quot;- 带货力：根据单位时间内的交易额、交易量等数据指标综合评估直播间主播的带货能力\n- 互动力：根据单位时间内的直播间观看时长、分享率、评论率等数据指标综合评估直播间的互动氛围\n- 吸引力：根据单位时间内购买商品的新用户数、新增粉丝数等数据指标综合评估直播间对平台用户的吸引力&quot;,&quot;title&quot;:&quot;指标解读&quot;},{&quot;content&quot;:&quot;- 为保证榜单时效性，榜单每小时进行动态更新。由于技术等原因，榜单更新时间偶有延迟，具体更新时间以实际情况为准。\n- 直播间榜单会露出商品名称和商品标签。所有的上榜直播间都会展示一款商品，并露出对应的商品名称。同时，结合商品名称的露出，会露出唯一的商品标签，该标签由算法选取商品详情页的商品已有标签作为候选，不同的用户看到的标签不尽相同。整体上，商品标签的露出是为了给用户提供更多的决策理由，帮助更快的找到合适的直播间/商品。\n- 榜单排名旁的说明属于热度值标签，用于鼓励榜单中前3名的直播间和整体数据表现较好的直播间。热度标签只有三种，分别为：蝉联榜首、持续霸榜、排名飙升。每个直播间最多展示一种标签，若同一直播间同时获得多种热度标签，则按算法筛选展示唯一标签。\n- 平台将实时监控上榜直播间的数据表现，若发现直播间有刷单、互动异常、售卖假冒盗版商品等违规作弊行为，将立即对违规直播间进行下榜。低质作者、近期有虚假交易判罚、假货山寨判罚、直播间有处罚消息的作者均会有一定的上榜限制，请务必诚信经营、用心直播。&quot;,&quot;title&quot;:&quot;补充说明&quot;}],&quot;ecom_live_scene_id_allow_list&quot;:[&quot;1001&quot;,&quot;1003&quot;,&quot;1031&quot;,&quot;1098&quot;,&quot;1099&quot;,&quot;1046&quot;,&quot;1091&quot;,&quot;1092&quot;,&quot;1473&quot;,&quot;1082&quot;,&quot;1086&quot;,&quot;1087&quot;,&quot;1112&quot;,&quot;1491&quot;,&quot;1493&quot;],&quot;enable_all_service_reuse&quot;:0,&quot;enable_audio_focus_backgound&quot;:false,&quot;enable