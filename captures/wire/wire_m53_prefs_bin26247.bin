3dmain\\u0026type\\u003dpopup\\u0026gravity\\u003dbottom\\u0026pull_down_close\\u003d1\\u0026height_percent\\u003d75\\u0026pull_down_indicator_not_show\\u003d1\\u0026web_bg_color\\u003d%23fff8f8f8\\u0026url\\u003dhttps%3A%2F%2Flf-webcast-gr-sourcecdn.bytegecko.com%2Fobj%2Fbyte-gurd-source-gr%2Fwebcast%2Fmono%2Fh5%2Fwebcast_personal_center%2Fpages%2Fmain.html%3F_pia_%3D1%26request_page%3Dgift_tab\&quot;,\&quot;notice\&quot;:[{\&quot;level\&quot;:1,\&quot;notice_text\&quot;:\&quot;Lv.1 获得荣誉等级勋章\&quot;},{\&quot;level\&quot;:10,\&quot;notice_text\&quot;:\&quot;Lv.10 获得房间升级通告\&quot;},{\&quot;level\&quot;:20,\&quot;notice_text\&quot;:\&quot;Lv.20 获得新的等级礼物\&quot;},{\&quot;level\&quot;:25,\&quot;notice_text\&quot;:\&quot;Lv.25 获得100人以下房间入场特效\&quot;},{\&quot;level\&quot;:30,\&quot;notice_text\&quot;:\&quot;Lv.30 获得新的等级礼物\&quot;},{\&quot;level\&quot;:32,\&quot;notice_text\&quot;:\&quot;Lv.32 获得全部直播间入场特效\&quot;},{\&quot;level\&quot;:33,\&quot;notice_text\&quot;:\&quot;Lv.33 解锁基础弹幕（限500人内直播间）\&quot;},{\&quot;level\&quot;:36,\&quot;notice_text\&quot;:\&quot;Lv.36 解锁高级弹幕（限1000人内直播间）\&quot;},{\&quot;level\&quot;:40,\&quot;notice_text\&quot;:\&quot;Lv.40 解锁至尊弹幕（限100w人内直播间）\&quot;},{\&quot;level\&quot;:60,\&quot;notice_text\&quot;:\&quot;Lv.60 恭喜你升至满级\&quot;}],\&quot;show_level_panel\&quot;:true}&quot;,&quot;live_gurd_patterns&quot;:&quot;[\&quot;mix.jinritemai.com/falcon/\&quot;,\&quot;lf1-fe.ecombdstatic.com/obj/ecom-cdn-default/\&quot;,\&quot;https://sf1-scmcdn-tos.pstatp.com/goofy/ies/live/\&quot;,\&quot;tosv.byted.org/obj/gecko-internal/webcast/ecom/lynx/\&quot;,\&quot;tosv.byted.org/obj/gecko-internal/webcast/mono/h5/\&quot;,\&quot;lf-webcast-sourcecdn-tos.bytegecko.com/obj/byte-gurd-source/webcast/ecom/lynx/\&quot;,\&quot;lf-webcast-sourcecdn-tos.bytegecko.com/obj/byte-gurd-source/10181/gecko/resource/\&quot;]&quot;,&quot;__origin_Type__live_pk_steal_dragon_setting_show&quot;:4,&quot;live_vs_room_drawer_config&quot;:&quot;{\&quot;enable_camera_jump_back\&quot;:true,\&quot;enable_landscape_entrance\&quot;:true,\&quot;enable_landscape_jump\&quot;:false,\&quot;enable_landscape_scale\&quot;:true,\&quot;enable_portrait_entrance\&quot;:true,\&quot;enable_special_drawer\&quot;:true,\&quot;schema_support_open_drawer\&quot;:true}&quot;,&quot;diamond_exchange_url&quot;:&quot;sslocal://webcast_lynxview?url=https%3A%2F%2Flf-webcast-sourcecdn-tos.bytegecko.com%2Fobj%2Fbyte-gurd-source%2Fwebcast%2Fmono%2Flynx%2Frevenue_revenue_wallet_saas%2Fpages%2Fdiamond_exchange%2Ftemplate.js%3Fsource%3Droom_in_gift_panel&amp;hide_nav_bar=1&amp;host=aweme&amp;type=popup&amp;gravity=bottom&amp;height=522&amp;show_dim=1&amp;engine_type=new&quot;,&quot;__origin_Type__live_strategy_white_factor_setting&quot;:1,&quot;__origin_Type__anniex_card_blocklist&quot;:1,&quot;__origin_Type__anchor_style_daily_rank&quot;:2,&quot;__origin_Type__live_interact_gift_emoji_settings&quot;:0,&quot;live_performance_setting&quot;:&quot;{\&quot;enable\&quot;:true,\&quot;enable_report_v1\&quot;:false,\&quot;enable_report_v2\&quot;:true,\&quot;fps_duration\&quot;:3000,\&quot;fps_duration_anchor\&quot;:3000,\&quot;min_interval\&quot;:8000,\&quot;min_monitor_interval\&quot;:8000,\&quot;min_monitor_interval_anchor\&quot;:8000,\&quot;monitor_delay\&quot;:1000,\&quot;resident_interval\&quot;:15000,\&quot;resident_interval_anchor\&quot;:15000,\&quot;sample_count_audience\&quot;:1}&quot;,&quot;__origin_Type__live_like_audience_digg_ab_test&quot;:2,&quot;__origin_Type__schema_anchor_center&quot;:3,&quot;ecom_live_product_rank_ruler&quot;:&quot;[{\&quot;content\&quot;:\&quot;- 抖音电商直播间带货榜是根据真实数据进行排名的直播间排行榜，希望帮助消费者通过榜单找到正在直播的好商品，让选择更简单。直播间排名越靠前曝光机会越大。\&quot;,\&quot;title\&quot;:\&quot;直播间带货榜\&quot;},{\&quot;content\&quot;:\&quot;- 直播间带货榜当前分为总榜、抖音旗舰榜、特色主题榜、国家补贴榜、商品类目榜，榜单形态持续更新中：\\n- 总榜：按照上榜规则对全部电商直播间进行排序展示\\n- 抖音旗舰榜：聚合抖音旗舰店铺热销直播间进行排序展示\\n- 特色主题榜：由抖音电商运营就特色主题或活动，按照特定规则对直播间进行圈选后排序展示\\n- 国家补贴榜：聚合正在直播国家补贴商品的直播间进行排序展示\\n- 商品类目榜：按照直播间在播商品所属类目对相关直播间进行排序后展示\&quot;,\&quot;title\&quot;:\&quot;榜单介绍\&quot;},{\&quot;content\&quot;:\&quot;- 上榜直播间均为正在直播的直播间\\n- 上榜作者基础要求：近30天无虚假交易处罚记录，近14天退单率无异常、无严重违规记录\\n- 排序规则：以该直播间所售卖商品的【带货力、互动力、吸引力】进行综合排名，每小时结算\&quot;,\&quot;title\&quot;:\&quot;上榜规则\&quot;},{\&quot;content\&quot;:\&quot;- 带货力：根据单位时间内的交易额、交易量等数据指标综合评估直播间主播的带货能力\\n- 互动力：根据单位时间内的直播间观看时长、分享率、评论率等数据指标综合评估直播间的互动氛围\\n- 吸引力：根据单位时间内购买商品的新用户数、新增粉丝数等数据指标综合评估直播间对平台用户的吸引力\&quot;,\&quot;title\&quot;:\&quot;指标解读\&quot;},{\&quot;content\&quot;:\&quot;- 为保证榜单时效性，榜单每小时进行动态更新。由于技术等原因，榜单更新时间偶有延迟，具体更新时间以实际情况为准。\\n- 直播间榜单会露出商品名称和商品标签。所有的上榜直播间都会展示一款商品，并露出对应的商品名称。同时，结合商品名称的露出，会露出唯一的商品标签，该标签由算法选取商品详情页的商品已有标签作为候选，不同的用户看到的标签不尽相同。整体上，商品标签的露出是为了给用户提供更多的决策理由，帮助更快的找到合适的直播间/商品。\\n- 榜单排名旁的说明属于热度值标签，用于鼓励榜单中前3名的直播间和整体数据表现较好的直播间。热度标签只有三种，分别为：蝉联榜首、持续霸榜、排名飙升。每个直播间最多展示一种标签，若同一直播间同时获得多种热度标签，则按算法筛选展示唯一标签。\\n- 平台将实时监控上榜直播间的数据表现，若发现直播间有刷单、互动异常、售卖假冒盗版商品等违规作弊行为，将立即对违规直播间进行下榜。低质作者、近期有虚假交易判罚、假货山寨判罚、直播间有处罚消息的作者均会有一定的上榜限制，请务必诚信经营、用心直播。\&quot;,\&quot;title\&quot;:\&quot;补充说明\&quot;}]&quot;,&quot;live_multi_link_seat_name_panel_lynx&quot;:&quot;{\&quot;seat_name_panel_schema\&quot;:\&quot;sslocal://webcast_lynxview?rate_width\\u003d375\\u0026gravity\\u003dbottom\\u0026type\\u003dpopup\\u0026android_soft_input_mode\\u003d32\\u0026group\\u003dlivelinkmic\\u0026business_type\\u003dlivelinkmic\\u0026business_group\\u003dlivelinkmic\&quot;,\&quot;seat_name_panel_url\&quot;:\&quot;https://lf-webcast-gr-sourcecdn.bytegecko.com/obj/byte-gurd-source-gr/webcast/mono/lynx/linkmic_manage_saas/pages/input_seat_name_panel/template.js\&quot;}&quot;,&quot;__origin_Type__is_hit_ui_upgrade&quot;:3,&quot;__origin_Type__live_broadcast_room_intro_enable&quot;:4,&quot;__origin_Type__vs_live_program_list_marquee_delay&quot;:2,&quot;__origin_Type__live_open_authorize_config&quot;:0,&quot;__origin_Type__live_hardware_decode_bytevc1_enable&quot;:2,&quot;live_gift_guide_type&quot;:1,&quot;__origin_Type__new_sticker_mp4_asset_ids&quot;:0,&quot;live_cooperation_partner_add_player_list_enable&quot;:false,&quot;__origin_Type__live_remote_pk_entry_panel_ur